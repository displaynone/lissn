{
  "name": "lissn",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "dev:client": "expo install expo-dev-client",
    "prebuild": "expo prebuild -p android",
    "build:eas": "eas build --platform android --profile development",
    "build:local": "eas build --platform android --profile preview --local",
    "lingui:extract": "npx lingui extract",
    "lingui:compile": "npx lingui compile",
    "tamagui:check": "npx @tamagui/cli check",
    "tamagui:generate": "npx @tamagui/cli generate",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "release": "semantic-release --no-ci"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@hookform/resolvers": "^5.2.1",
    "@kaannn/react-native-waveform": "^0.1.4",
    "@lingui/core": "^5.4.1",
    "@lingui/react": "^5.4.1",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@shopify/flash-list": "1.7.6",
    "@tamagui/babel-plugin": "^1.132.10",
    "@tamagui/config": "^1.132.10",
    "@tamagui/linear-gradient": "^1.132.10",
    "@tamagui/theme-builder": "^1.132.10",
    "@tamagui/toast": "^1.132.10",
    "ajv": "^8.17.1",
    "buffer": "^6.0.3",
    "burnt": "^0.13.0",
    "color2k": "^2.0.3",
    "expo": "~53.0.23",
    "expo-audio": "~0.4.9",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.0",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-localization": "^16.1.6",
    "expo-media-library": "~17.1.7",
    "expo-navigation-bar": "~4.2.8",
    "expo-router": "~5.1.7",
    "expo-sharing": "^13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "music-metadata-browser": "^2.5.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "tamagui": "^1.132.10",
    "zod": "^4.0.17",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@lingui/babel-plugin-lingui-macro": "^5.4.1",
    "@lingui/cli": "^5.4.1",
    "@lingui/macro": "^5.4.1",
    "@lingui/metro-transformer": "^5.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@tamagui/cli": "^1.132.10",
    "@types/react": "~19.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "semantic-release": "^22.0.12",
    "typescript": "~5.8.3"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "@nozbe/watermelondb",
          "@kaannn/react-native-waveform",
          "@tamagui/.*",
          "ajv",
          "buffer",
          "color2k",
          "music-metadata-browser"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
